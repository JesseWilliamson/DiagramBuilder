{
  "name": "@dsviz/react",
  "version": "3.0.1",
  "description": "React bindings for dsviz: Diagram, usePlayer and small controls",
  "author": "Jesse Williamson",
  "homepage": "https://jessewilliamson.github.io/DiagramBuilder/",
  "type": "module",
