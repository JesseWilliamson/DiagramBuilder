{
  "name": "dsviz",
  "version": "3.1.0",
  "description": "Interactive, animated SVG teaching diagrams for computer science",
  "author": "Jesse Williamson",
  "homepage": "https://jessewilliamson.github.io/DiagramBuilder/",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.js"
    },
    "./ds": {
      "types": "./dist/ds/index.d.ts",
      "import": "./dist/ds/index.js"
    },
    "./plot": {
      "types": "./dist/plot/index.d.ts",
      "import": "./dist/plot/index.js"
    },
    "./prob": {
      "types": "./dist/prob/index.d.ts",
      "import": "./dist/prob/index.js"
    },
    "./geom": {
      "types": "./dist/geom/index.d.ts",
      "import": "./dist/geom/index.js"
    },
    "./os": {
      "types": "./dist/os/index.d.ts",
      "import": "./dist/os/index.js"
    },
    "./arch": {
      "types": "./dist/arch/index.d.ts",
      "import": "./dist/arch/index.js"
    },
    "./uml": {
      "types": "./dist/uml/index.d.ts",
      "import": "./dist/uml/index.js"
    },
    "./git": {
      "types": "./dist/git/index.d.ts",
      "import": "./dist/git/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "bin": {
    "dsviz": "./bin/dsviz.js"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "registry"
  ],
  "scripts": {
    "dev": "vite",
    "build:site": "vite build",
    "build": "node build.mjs",
    "registry": "node scripts/registry.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync:skill": "node scripts/sync-skill.mjs"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-toggle-group": "^1.2.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.3",
    "katex": "^0.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sucrase": "^3.35.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JesseWilliamson/DiagramBuilder.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
