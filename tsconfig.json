{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "dsviz": [
        "./src/index.ts"
      ],
      "dsviz/react": [
        "./src/react/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "site",
    "tests"
  ]
}