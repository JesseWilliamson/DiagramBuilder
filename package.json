    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.3",
    "katex": "^0.19.0",
